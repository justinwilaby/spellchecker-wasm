{
  "name": "spellchecker-wasm",
  "version": "0.3.3",
  "repository": "https://github.com/justinwilaby/spellchecker-wasm",
  "description": "An extremely fast multi-thread capable Spellchecker written in Rust compiled to WebAssembly for Node.",
  "type": "module",
  "main": "./lib/esm/index.js",
  "exports": {
    ".": "./lib/esm/index.js"
  },
  "files": [
    "lib",
    "bin"
  ],
  "scripts": {
    "test": "node --test --enable-source-maps 'src/js/**/*.spec.ts'",
    "test:watch": "node --test --watch --enable-source-maps 'src/js/**/*.spec.ts'",
    "test:coverage": "node --test --enable-source-maps --experimental-test-coverage 'src/js/**/*.spec.ts'",
    "test:web-integration": "node --enable-source-maps 'src/js/__tests__/web-integration.js'",
    "build:wasm": "rustc ./src/lib.rs -Clto -O --crate-type cdylib --target wasm32-unknown-unknown -C link-args=--import-undefined -o ./lib/spellchecker-wasm.wasm",
    "build:esm": "tsc --module esnext --outDir lib/esm --target esnext",
    "build:cjs": "tsc --module commonjs --outDir lib/cjs --target esnext",
    "build:types": "tsc --outDir lib/types --emitDeclarationOnly --declaration",
    "build": "(npm run build:esm && npm run build:cjs & npm run build:types) && npm run build:wasm",
    "build:dev": "(npm run build:esm -- --sourceMap && npm run build:cjs -- --sourceMap & npm run build:types) && npm run build:wasm && tsc --emitDeclarationOnly",
    "postinstall": "node ./bin/decompress"
  },
  "keywords": [
    "spellchecker",
    "spell-checker",
    "spelling",
    "electron",
    "wasm",
    "webassembly",
    "node",
    "symspell"
  ],
  "author": "Justin Wilaby",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "spellcheck": "./bin/spellchecker"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.0",
    "yargs": "^17.0.0"
  }
}
