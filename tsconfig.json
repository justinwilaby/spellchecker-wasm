{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2020",
    "outDir": "lib",
    "declaration": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "rootDir": "src/js",
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },
  "include": ["src/js/**/*.ts"],
  "exclude": ["src/js/**/*.spec.ts"]
}